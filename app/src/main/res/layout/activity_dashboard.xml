<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".DashboardActivity">

    <!-- ===== Header ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_header_gradient"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="20dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_result"
            android:contentDescription="Dashboard"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistik pemantauan kesehatan padi"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="#DCF3DD"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/logo"
            android:layout_width="76dp"
            android:layout_height="34dp"
            android:src="@drawable/logo_ra_atap"
            android:contentDescription="RA-ATAP"
            android:scaleType="fitEnd" />
    </LinearLayout>

    <!-- ===== Content ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/bottom_nav"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layoutAnimation="@anim/layout_animation_rise"
            tools:layoutAnimation="@null"
            android:paddingBottom="24dp">

            <!-- ===== Sumber data ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUMBER DATA"
                    style="@style/TextLabel" />

                <TextView
                    android:id="@+id/tvDashServerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Server belum diatur"
                    android:drawableStart="@drawable/ic_wifi"
                    android:drawableTint="@color/green_primary"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    style="@style/TextSubtitle"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnDashRefresh"
                    android:layout_width="match_parent"
                    android:layout_marginTop="14dp"
                    android:text="Muat Ulang Data"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawableTint="@color/green_primary"
                    style="@style/ButtonOutline" />
            </LinearLayout>

            <!-- ===== Pesan status (error/kosong) ===== -->
            <TextView
                android:id="@+id/tvDashMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="14dp"
                android:background="@drawable/bg_card_soft"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:text=""
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/montserrat_medium"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- ===== Ringkasan (stat tiles) ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="4dp"
                android:text="RINGKASAN"
                style="@style/TextLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Total -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="6dp">

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Total"
                        style="@style/TextCaption" />
                </LinearLayout>

                <!-- Sehat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="6dp">

                    <TextView
                        android:id="@+id/tvHealthy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:textColor="@color/status_success"
                        android:textSize="26sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sehat"
                        style="@style/TextCaption" />
                </LinearLayout>

                <!-- Terinfeksi -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="6dp">

                    <TextView
                        android:id="@+id/tvInfected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:textColor="@color/status_danger"
                        android:textSize="26sp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Terinfeksi"
                        style="@style/TextCaption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Tingkat kesehatan ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tingkat kesehatan lahan"
                        style="@style/TextSubtitle"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHealthPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="–"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/status_success"
                        android:textSize="18sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/healthBarTrack"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_bar_rounded"
                    android:backgroundTint="@color/stroke_light"
                    android:weightSum="1">

                    <View
                        android:id="@+id/barHealthy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/status_success" />

                    <View
                        android:id="@+id/barInfected"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/status_danger" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_bar_rounded"
                        android:backgroundTint="@color/status_success" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="16dp"
                        android:text="Sehat"
                        style="@style/TextCaption" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_bar_rounded"
                        android:backgroundTint="@color/status_danger" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Terinfeksi"
                        style="@style/TextCaption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Distribusi penyakit ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="4dp"
                android:text="DISTRIBUSI PENYAKIT"
                style="@style/TextLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvDiseaseEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada penyakit terdeteksi"
                    android:drawableStart="@drawable/ic_check_circle"
                    android:drawableTint="@color/status_success"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    style="@style/TextBody" />

                <LinearLayout
                    android:id="@+id/diseaseContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== Waktu respons server ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="4dp"
                android:text="WAKTU RESPONS SERVER"
                style="@style/TextLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvRespSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada data waktu respons"
                    android:drawableStart="@drawable/ic_clock"
                    android:drawableTint="@color/green_primary"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    style="@style/TextBody" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== Bottom Navigation ===== -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_nav_bawah"
        android:orientation="horizontal"
        android:weightSum="5"
        android:elevation="16dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_home"
                android:tint="@color/text_muted"
                android:padding="12dp"
                android:contentDescription="Home"
                android:scaleType="centerInside" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/nav_camera"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_camera"
                android:tint="@color/text_muted"
                android:padding="12dp"
                android:contentDescription="Camera"
                android:scaleType="centerInside" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/nav_result"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_result"
                android:tint="@color/text_muted"
                android:padding="12dp"
                android:contentDescription="Result"
                android:scaleType="centerInside" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/nav_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_setting"
                android:tint="@color/text_muted"
                android:padding="12dp"
                android:contentDescription="Settings"
                android:scaleType="centerInside" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/nav_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_user"
                android:tint="@color/text_muted"
                android:padding="12dp"
                android:contentDescription="Profile"
                android:scaleType="centerInside" />
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>
