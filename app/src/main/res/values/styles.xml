<resources>

    <!-- ============ TYPOGRAPHY (Montserrat) ============ -->
    <style name="TextDisplay">
        <item name="android:fontFamily">@font/montserrat_extrabold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextTitle">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextSubtitle">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextBody">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextCaption">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Small uppercase section label -->
    <style name="TextLabel">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ============ BUTTONS ============ -->
    <style name="ButtonPrimary">
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <!-- Montserrat punya spasi vertikal ekstra; matikan agar teks sejajar dengan ikon -->
        <item name="android:includeFontPadding">false</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="ButtonOutline">
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <!-- Montserrat punya spasi vertikal ekstra; matikan agar teks sejajar dengan ikon -->
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ============ INPUT ============ -->
    <style name="InputField">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:drawablePadding">10dp</item>
    </style>

</resources>
